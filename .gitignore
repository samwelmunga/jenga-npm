# Machine-local paths — never commit
.jenga_paths

# Project-scoped scratch dir used by ad-hoc helpers (legacy: distribute-changes.sh)
.jenga_tmp/

# Ad-hoc smoke-test scratch space (e.g. fake consumer installs)
.tmp/

# Python temp files
**/__pycache__

# fine tuning jobs
jobs/

# macOS
.DS_Store

# Environment files
.env
.env.*
*.local
*.pid
node_modules/

# npm pack artifacts (e.g. from manual verification runs like E26_S09_T03)
*.tgz

# Jenga runtime files (machine-local, auto-generated)
mcp/router/.pid
mcp/router/.session.json

# Worktrees
**/worktrees/

# Public mirror scratch worktree (used by /mirror-public)
.mirror-worktrees/

# Claude/Copilot session artefacts
agents/.agents/

# Per-session handoff files (project/queue/handoffs/) are transient,
# single-use signals consumed and deleted by hooks/on_session_end.sh
# immediately after routing (see templates/SCRUM_BOARD_SCHEMA.md's
# handoffs/ section: "A file must not persist once it has been
# consumed."). They must never be durable git artifacts — E37_S01_T02
# found ~25 of them had been committed anyway (swept up by unrelated
# `git add -A` commits before the hook ever consumed this directory) and
# accumulated into a resurrection hazard: a later, correct consumer would
# treat them as live signals for work already fully shipped. This rule
# structurally prevents recurrence rather than relying on every agent to
# remember not to `git add` this directory.
project/queue/handoffs/*.json
!project/queue/handoffs/.gitkeep

# Conversational elicitation state (project/queue/elicitation-state/,
# skills/uncharted/scripts/elicitation-state.sh — E20_S08_T03) is
# session-scratch resumability data for /uncharted's convergence loop, not a
# durable artifact — the durable output of a converged elicitation is the
# graph write (project/knowledge-graph/graph.json) and the [ARCH]-tagged
# board item, both written separately. Mirrors the handoffs/ rule above for
# the same reason: it must never become a durable git artifact that a later
# session could mistake for a live in-progress signal.
project/queue/elicitation-state/*.json
!project/queue/elicitation-state/.gitkeep

# resolved_context digest files (project/queue/context/ — E49_S01_T02) are
# transient, single-use handoff payloads written by scripts/write-context-digest.sh
# and consumed (read + deleted) by scripts/consume-context-digest.sh, with
# scripts/sweep-stale-context-digests.sh as an age-based backstop for a digest
# whose intended receiver never consumes it. Mirrors the handoffs/ rule above
# for the same reason: a digest is a per-session scratch payload referenced by
# a handoff's resolved_context field, not a durable record — the durable
# record is the handoff/board state that referenced it. See
# templates/SCRUM_BOARD_SCHEMA.md's resolved_context subsection.
project/queue/context/*.json
!project/queue/context/.gitkeep

# Pre-flight checklist tick state (project/queue/checklist-ticks/,
# scripts/checklist.sh tick — E67_S02_T03) is private operational state: the
# shared persistent.json, one run-<digest>.json per run id, and the transient
# *.lock.d / .tmp-* entries the lock and the write-then-rename leave beside
# them. A persistent tick is meant to outlive a session, which is exactly why
# it must never become a durable git artifact (a committed tick would satisfy
# a checklist item on every clone). Mirrors the handoffs/ rule above; the
# directory is also blocklisted for the public mirror via project/queue/.
project/queue/checklist-ticks/*
!project/queue/checklist-ticks/.gitkeep

# Situation marker (project/queue/checklist-markers/,
# scripts/checklist-marker.sh — E67_S04_T01) is the transient "which
# lifecycle phase is this session in" value the enforcing hook reads: one
# marker-<digest>.json per session key, plus the *.lock.d / .tmp-* entries the
# lock and the write-then-rename leave beside them. It is meaningful only for
# the session that wrote it and only until its TTL expires, so committing one
# would gate every clone on a phase that is not running. Sibling of the
# checklist-ticks/ rule above; also blocklisted for the public mirror via
# project/queue/.
project/queue/checklist-markers/*
!project/queue/checklist-markers/.gitkeep
