{
  "name": "@jenga-ai/agent",
  "version": "2.0.0",
  "description": "An agentic development workflow for Claude Code, Copilot, and Codex \u2014 with a persistent Epic/Story/Task board, an isolated git worktree per task, and a separate tester agent that runs your test suite before anything is marked done.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jenga": "bin/jenga.js"
  },
  "engines": {
    "node": ">=14.13.1"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "bats tests/*.bats",
    "validate:npm-metadata": "bash scripts/validate_npm_metadata.sh",
    "ui:dev": "npm run ui:dev --prefix project/app --",
    "ui:build": "npm run ui:build --prefix project/app --",
    "api:start": "npm run api:start --prefix project/app --",
    "api:dev": "npm run api:dev --prefix project/app --",
    "dashboard:start": "npm run dashboard:start --prefix project/app --",
    "dashboard:open": "npm run dashboard:open --prefix project/app --"
  },
  "files": [
    "skills/",
    "agents/",
    "hooks/",
    "scripts/",
    "templates/",
    "bin/",
    "lib/",
    "mcp/execute-ticket/*.js",
    "mcp/execute-ticket/package.json",
    "mcp/help/*.js",
    "mcp/help/package.json",
    "mcp/router/*.js",
    "mcp/router/package.json",
    "mcp/router/package-lock.json",
    "mcp/router/README.md",
    "mcp/training_runner/*.js",
    "mcp/training_runner/package.json",
    "mcp/training_runner/package-lock.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samwelmunga/jenga-npm.git"
  },
  "homepage": "https://github.com/samwelmunga/jenga-npm#readme",
  "bugs": {
    "url": "https://github.com/samwelmunga/jenga-npm/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "agentic",
    "workflow",
    "framework",
    "engineering",
    "development",
    "coding",
    "context",
    "software",
    "kanban",
    "board",
    "management",
    "claude",
    "claude-code",
    "agents-md",
    "copilot",
    "codex",
    "jenga",
    "jenga-ai"
  ],
  "author": {
    "name": "Samwel Munga",
    "email": "samwelmunga88@hotmail.se",
    "url": "https://knappkod.se/jenga-ai"
  },
  "license": "MIT",
  "devDependencies": {
    "bats": "^1.13.0"
  }
}
