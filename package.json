{
  "name": "@jenga-ai/agent",
  "version": "1.0.1",
  "description": "JengaAgent — agentic project management CLI",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jenga": "bin/jenga.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "ui:dev": "npm run ui:dev --prefix project/app",
    "ui:build": "npm run ui:build --prefix project/app",
    "api:start": "npm run api:start --prefix project/app",
    "api:dev": "npm run api:dev --prefix project/app",
    "dashboard:start": "npm run dashboard:start --prefix project/app",
    "dashboard:open": "npm run dashboard:open --prefix project/app"
  },
  "files": [
    "skills/",
    "agents/",
    "hooks/",
    "scripts/",
    "templates/",
    "bin/",
    "lib/",
    "mcp/execute-ticket/",
    "mcp/help/",
    "mcp/router/index.js",
    "mcp/router/matcher.js",
    "mcp/router/embedder.js",
    "mcp/router/skill-index.js",
    "mcp/router/package.json",
    "mcp/router/package-lock.json",
    "mcp/router/README.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
