{
  "name": "@jenga-ai/agent",
  "version": "1.2.3",
  "description": "Structured multi-agent development workflow for AI coding agents — scrum board, role-bounded scrum master / developer / tester agents, and 30+ slash-command skills. Works with Claude Code, GitHub Copilot, and Codex.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jenga": "./bin/jenga.js"
  },
  "engines": {
    "node": ">=14.13.1"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "bats tests/*.bats",
    "validate:npm-metadata": "bash scripts/validate_npm_metadata.sh",
    "ui:dev": "npm run ui:dev --prefix project/app",
    "ui:build": "npm run ui:build --prefix project/app",
    "api:start": "npm run api:start --prefix project/app",
    "api:dev": "npm run api:dev --prefix project/app",
    "dashboard:start": "npm run dashboard:start --prefix project/app",
    "dashboard:open": "npm run dashboard:open --prefix project/app"
  },
  "files": [
    "skills/",
    "agents/",
    "hooks/",
    "scripts/",
    "templates/",
    "bin/",
    "lib/",
    "mcp/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samwelmunga/jenga-npm.git"
  },
  "homepage": "https://github.com/samwelmunga/jenga-npm#readme",
  "bugs": {
    "url": "https://github.com/samwelmunga/jenga-npm/issues"
  },
  "keywords": [
    "ai-agents",
    "agentic",
    "agentic-workflow",
    "multi-agent",
    "agent-framework",
    "ai-development",
    "claude",
    "claude-code",
    "agents-md",
    "copilot",
    "github-copilot",
    "codex",
    "skills",
    "project-management",
    "developer-tools",
    "cli"
  ],
  "author": {
    "name": "Samwel Munga",
    "email": "samwelmunga88@hotmail.se",
    "url": "https://knappkod.se/jenga-ai"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "overrides": {
    "sharp": "^0.34.5"
  },
  "comments": {
    "audit": "sharp <0.35.0 and adm-zip <0.6.0 are transitive deps of @huggingface/transformers with no upstream fix available. Not exploitable in this context: only text feature-extraction pipeline is used — no image processing or ZIP handling at application boundary. Review when @huggingface/transformers ships a patched release."
  },
  "devDependencies": {
    "bats": "^1.13.0"
  }
}
