{
  "name": "jenga-agent",
  "version": "1.0.0",
  "description": "JengaAgent — agentic project management CLI",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jenga": "./bin/jenga.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "ui:dev": "npm run ui:dev --prefix project/app",
    "ui:build": "npm run ui:build --prefix project/app",
    "api:start": "npm run api:start --prefix project/app",
    "api:dev": "npm run api:dev --prefix project/app",
    "dashboard:start": "npm run dashboard:start --prefix project/app",
    "dashboard:open": "npm run dashboard:open --prefix project/app"
  },
  "files": [
    "skills/",
    "agents/",
    "hooks/",
    "scripts/",
    "templates/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
