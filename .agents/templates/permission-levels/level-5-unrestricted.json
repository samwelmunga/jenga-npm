{
  "defaultMode": "acceptEdits",
  "permissions": {
    "deny": [
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(sudo *)",
      "Bash(su *)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(bash skills/j-mirror-public/scripts/mirror.sh*)"
    ]
  }
}
