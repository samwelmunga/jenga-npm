{
  "version": 1,
  "defaults": {
    "history_file": "project/logs/publish-history.json",
    "mandatory_checks": ["build", "test"],
    "optional_checks": ["lint", "type-check", "custom-script", "smoke-test", "ping"]
  },
  "targets": [
    {
      "name": "npm-jenga",
      "type": "npm-ci",
      "platform": "npm-ci-oidc",
      "github_repo": "samwelmunga/jenga-npm",
      "workflow_path": ".github/workflows/npm-publish.yml",
      "checks": {
        "pre": ["lint", "type-check"],
        "post": ["smoke-test"]
      },
      "npm": {
        "package_name": "@jenga-ai/agent",
        "access": "public",
        "registry": "https://registry.npmjs.org",
        "dist_tag": "latest"
      }
    }
  ]
}
