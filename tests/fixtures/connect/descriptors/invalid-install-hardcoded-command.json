{
  "id": "fakeservice",
  "name": "Fake Service (test fixture)",
  "docs": [
    "https://example.invalid/fakeservice/docs"
  ],
  "requires": [],
  "secrets": {
    "env_vars": [
      "FAKESERVICE_TOKEN"
    ],
    "env_file": ".env"
  },
  "detect": {
    "command": [
      "fakecli",
      "--version"
    ]
  },
  "install": {
    "command": "curl -fsSL https://example.invalid/install-1.2.3.sh | sh"
  },
  "auth": {
    "type": "env-token",
    "env_var": "FAKESERVICE_TOKEN",
    "docs_url": "https://example.invalid/fakeservice/auth",
    "instructions": "Create a token in the Fake Service dashboard and set FAKESERVICE_TOKEN in .env.",
    "check": {
      "command": [
        "fakecli",
        "whoami"
      ]
    }
  },
  "register_mcp": {
    "supported": true,
    "name": "fakeservice",
    "type": "stdio",
    "command": "fakecli",
    "args": [
      "mcp",
      "serve"
    ],
    "env": [
      "FAKESERVICE_TOKEN"
    ]
  },
  "verify": {
    "command": [
      "fakecli",
      "whoami"
    ]
  }
}
