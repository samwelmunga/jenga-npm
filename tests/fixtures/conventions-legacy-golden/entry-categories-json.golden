        "type": "string",
        "required": false,
        "single_line": true,
        "non_empty": true
      }
    }
  },
  {
    "id": "language-tooling",
    "label": "Language and tooling",
    "values": {
      "version_policy": {
        "type": "string",
        "required": true,
        "single_line": true,
        "non_empty": true
      },
      "runtime": {
        "type": "string",
        "required": false,
        "single_line": true,
        "non_empty": true
      },
      "package_manager": {
