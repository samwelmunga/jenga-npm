        "type": "string",
        "required": false,
        "single_line": true,
        "non_empty": true
      },
      "test_dir": {
        "type": "string",
        "required": false,
        "single_line": true,
        "non_empty": true
      }
    }
  },
  {
    "id": "file-layout",
    "label": "File and directory layout",
    "values": {
