    "description": "Whitespace and encoding are governed by an .editorconfig file, with no enforced formatter.",
    "values": {
      "approach": "editorconfig-only",
      "editorconfig": true
    },
    "placeholder_fields": []
  },
  {
    "id": "none-enforced",
    "label": "None enforced",
    "description": "No standing formatting or linting requirement.",
    "values": {
      "approach": "none-enforced"
    },
    "placeholder_fields": []
  }
