[
  {
    "id": "formatter-and-linter",
    "label": "Formatter and linter enforced",
    "description": "A formatter and linter are run by command; the commands shown are placeholders you must replace with your own.",
    "values": {
      "approach": "formatter-and-linter",
      "format_command": "<format command>",
      "lint_command": "<lint command>"
