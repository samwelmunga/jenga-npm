#!/usr/bin/env bats
#
# E85_S01_T09: the CI workflows /j-publish generates for an npm-ci target carry a dependency audit: an `audit`
# job that `publish` and `stage` depend on, plus a scheduled dependency-audit.yml rendered from
# skills/j-publish/assets/audit-workflow.yml.tpl. Nothing is triggered and nothing is published: every case runs
# npm_ci_pipeline.sh from a throwaway git repository under BATS_TEST_TMPDIR with a stub `gh` on PATH (it only
# records its arguments) and a local bare repository as `origin`, and asserts on the rendered YAML.

REPO_ROOT="$(cd "$(dirname "$BATS_TEST_FILENAME")/.." && pwd)"

setup() {
  P="$BATS_TEST_TMPDIR/svc"
  mkdir -p "$P/skills/j-publish/scripts" "$P/skills/j-publish/assets" "$BATS_TEST_TMPDIR/bin"
  cp "$REPO_ROOT/skills/j-publish/scripts/npm_ci_pipeline.sh" \
     "$REPO_ROOT/skills/j-publish/scripts/publish_common.sh" \
     "$REPO_ROOT/skills/j-publish/scripts/validate_npm_ci_env.sh" \
     "$REPO_ROOT/skills/j-publish/scripts/validate_config.sh" "$P/skills/j-publish/scripts/"
  cp "$REPO_ROOT/skills/j-publish/assets/audit-workflow.yml.tpl" "$P/skills/j-publish/assets/"
  mkdir -p "$P/skills/j-publish/schemas"
  cp "$REPO_ROOT/skills/j-publish/schemas/publish.schema.json" "$P/skills/j-publish/schemas/"
  printf '{"name":"my-pkg","version":"1.0.0"}\n' > "$P/package.json"
  # Stub gh: records every call, succeeds for everything (auth status, workflow run, run list).
  printf '#!/bin/sh\necho "$@" >> "%s/gh.calls"\necho https://example.invalid/run/1\n' "$BATS_TEST_TMPDIR" > "$BATS_TEST_TMPDIR/bin/gh"
  chmod +x "$BATS_TEST_TMPDIR/bin/gh"
  export PATH="$BATS_TEST_TMPDIR/bin:$PATH"
  git -C "$P" init -q
  git -C "$P" config user.email t@example.invalid
  git -C "$P" config user.name t
  git -C "$P" add -A
  git -C "$P" commit -q -m init
  PIPE="$P/skills/j-publish/scripts/npm_ci_pipeline.sh"
  VALIDATE="$P/skills/j-publish/scripts/validate_config.sh"
  CFG="$P/publish.json"
  write_cfg ""
}

# write_cfg <extra jq filter applied to the target> ; empty means the minimal npm-ci fixture unchanged.
write_cfg() {
  jq ".targets[0] |= (${1:-.})" "$REPO_ROOT/skills/j-publish/schemas/fixtures/npm-ci-minimal.json" > "$CFG"
}

# split_dry_run: sets PUB_YAML and AUDIT_YAML files from the combined dry-run output.
split_dry_run() {
  PUB_YAML="$BATS_TEST_TMPDIR/publish.yml"
  AUDIT_YAML="$BATS_TEST_TMPDIR/dependency-audit.yml"
  printf '%s\n' "$output" | awk -v pub="$PUB_YAML" -v aud="$AUDIT_YAML" '
    /^\[generate-workflow\] dry-run — dependency audit workflow/ { cur = ""; next }
    /^# Generated by \/publish npm-ci pipeline \(E85_S01_T09\)/ { cur = aud }
    /^# Generated by \/publish npm-ci pipeline — do not edit/ { cur = pub }
    cur != "" { print > cur }
  '
}

# yget <file> <python subscript expression on doc>
yget() {
  python3 - "$1" "$2" <<'PY'
import sys, json, yaml
doc = yaml.safe_load(open(sys.argv[1]))
if "on" not in doc and True in doc:   # PyYAML reads the bare key `on` as boolean True
    doc["on"] = doc.pop(True)
val = eval("doc" + sys.argv[2])
print(val if not isinstance(val, (dict, list)) else json.dumps(val, sort_keys=True))
PY
}

@test "dry-run prints a publish workflow with an audit job that publish and stage need" {
  run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
  [ "$status" -eq 0 ]
  split_dry_run
  run yget "$PUB_YAML" '["jobs"]["audit"]["steps"][-1]["run"]'
  [ "$output" = "npm audit --audit-level=high" ]
  run yget "$PUB_YAML" '["jobs"]["publish"]["needs"]'
  [ "$output" = "audit" ]
  run yget "$PUB_YAML" '["jobs"]["stage"]["needs"]'
  [ "$output" = "audit" ]
}

@test "the audit job reads contents only and runs npm audit directly, not scripts/audit-deps.sh" {
  run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
  split_dry_run
  run yget "$PUB_YAML" '["jobs"]["audit"]["permissions"]'
  [ "$output" = '{"contents": "read"}' ]
  run grep -q 'audit-deps.sh' "$PUB_YAML"
  [ "$status" -eq 1 ]
  run grep -Eq -- '--(yes|approved)' "$PUB_YAML"
  [ "$status" -eq 1 ]
}

@test "the --audit-level equals the target's audit_level" {
  for lvl in low moderate high critical; do
    write_cfg ".audit_level = \"$lvl\""
    run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
    [ "$status" -eq 0 ]
    split_dry_run
    run yget "$PUB_YAML" '["jobs"]["audit"]["steps"][-1]["run"]'
    [ "$output" = "npm audit --audit-level=$lvl" ]
    run yget "$AUDIT_YAML" '["jobs"]["audit"]["steps"][-1]["run"]'
    [ "$output" = "npm audit --audit-level=$lvl" ]
  done
}

@test "audit_level off omits the audit job, the needs lines and the scheduled workflow, and warns" {
  write_cfg '.audit_level = "off"'
  run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
  [ "$status" -eq 0 ]
  [[ "$output" == *"WARNING: audit_level is \"off\""* ]]
  split_dry_run
  [ ! -e "$AUDIT_YAML" ]
  run grep -q 'needs:' "$PUB_YAML"
  [ "$status" -eq 1 ]
  run grep -q 'npm audit' "$PUB_YAML"
  [ "$status" -eq 1 ]
  run yget "$PUB_YAML" '["jobs"].keys().__len__()'
  [ "$output" = "2" ]
}

@test "validate_config.sh accepts every allowed audit_level and rejects any other value" {
  for lvl in low moderate high critical off; do
    write_cfg ".audit_level = \"$lvl\""
    run bash "$VALIDATE" "$CFG"
    [ "$status" -eq 0 ]
  done
  for bad in bogus HIGH none ""; do
    write_cfg ".audit_level = \"$bad\""
    run bash "$VALIDATE" "$CFG"
    [ "$status" -eq 4 ]
    [[ "$output" == *"audit_level must be one of"* ]]
  done
  write_cfg '.audit_level = 3'
  run bash "$VALIDATE" "$CFG"
  [ "$status" -eq 4 ]
}

@test "the pipeline itself rejects an unknown audit_level before rendering" {
  write_cfg '.audit_level = "bogus"'
  run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
  [ "$status" -eq 4 ]
  [[ "$output" == *"audit_level must be one of"* ]]
}

@test "the shipped npm-ci example config validates and sets audit_level" {
  run bash "$VALIDATE" "$REPO_ROOT/skills/j-publish/assets/publish.example.npm-ci.json"
  [ "$status" -eq 0 ]
  run jq -r '.targets[0].audit_level' "$REPO_ROOT/skills/j-publish/assets/publish.example.npm-ci.json"
  [ "$output" = "high" ]
}

@test "the schema declares audit_level with the five allowed values" {
  run jq -c '.definitions.target.properties.audit_level.enum' "$REPO_ROOT/skills/j-publish/schemas/publish.schema.json"
  [ "$output" = '["low","moderate","high","critical","off"]' ]
}

@test "dependency-audit.yml is valid YAML with the three triggers, contents read, SHA pins and no secrets" {
  run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
  split_dry_run
  run yget "$AUDIT_YAML" '["on"].keys().__len__()'
  [ "$output" = "3" ]
  run yget "$AUDIT_YAML" '["on"]["schedule"][0]["cron"]'
  [ "$status" -eq 0 ]
  [ -n "$output" ]
  run yget "$AUDIT_YAML" '["on"]["workflow_dispatch"] is None'
  [ "$output" = "True" ]
  run yget "$AUDIT_YAML" '["on"]["pull_request"]["paths"]'
  [ "$output" = '["package.json", "package-lock.json"]' ]
  run yget "$AUDIT_YAML" '["permissions"]'
  [ "$output" = '{"contents": "read"}' ]
  run grep -q 'secrets\.' "$AUDIT_YAML"
  [ "$status" -eq 1 ]
  run grep -q 'id-token' "$AUDIT_YAML"
  [ "$status" -eq 1 ]
  local uses
  uses="$(grep -E '^\s*uses:' "$AUDIT_YAML" | sed -E 's/.*uses:[[:space:]]*//')"
  [ -n "$uses" ]
  while IFS= read -r u; do
    [[ "$u" =~ @[0-9a-f]{40}$ ]]
  done <<< "$uses"
}

@test "the audit workflow's action pin matches the publish workflow's checkout pin" {
  run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
  split_dry_run
  pin="$(grep -Eo 'actions/checkout@[0-9a-f]{40}' "$AUDIT_YAML" | head -1)"
  [ -n "$pin" ]
  grep -q "$pin" "$PUB_YAML"
}

@test "--dry-run writes no file, makes no commit and never dispatches a workflow" {
  before="$(git -C "$P" rev-parse HEAD)"
  run bash "$PIPE" --target my-pkg --config "$CFG" --dry-run
  [ "$status" -eq 0 ]
  [ ! -e "$P/.github" ]
  [ "$(git -C "$P" rev-parse HEAD)" = "$before" ]
  run grep -q 'workflow run' "$BATS_TEST_TMPDIR/gh.calls"
  [ "$status" -eq 1 ]
}

@test "the real path writes and commits both workflow files in one commit" {
  git init -q --bare "$BATS_TEST_TMPDIR/origin.git"
  git -C "$P" remote add origin "$BATS_TEST_TMPDIR/origin.git"
  before="$(git -C "$P" rev-parse HEAD)"
  run bash "$PIPE" --target my-pkg --config "$CFG"
  [ "$status" -eq 0 ]
  [ -f "$P/.github/workflows/npm-publish.yml" ]
  [ -f "$P/.github/workflows/dependency-audit.yml" ]
  [ "$(git -C "$P" rev-list --count "$before"..HEAD)" = "1" ]
  run git -C "$P" show --name-only --pretty=format: HEAD
  [[ "$output" == *".github/workflows/npm-publish.yml"* ]]
  [[ "$output" == *".github/workflows/dependency-audit.yml"* ]]
  grep -q 'workflow run' "$BATS_TEST_TMPDIR/gh.calls"
}

@test "the real path with audit_level off commits only the publish workflow" {
  write_cfg '.audit_level = "off"'
  git init -q --bare "$BATS_TEST_TMPDIR/origin.git"
  git -C "$P" remote add origin "$BATS_TEST_TMPDIR/origin.git"
  run bash "$PIPE" --target my-pkg --config "$CFG"
  [ "$status" -eq 0 ]
  [ -f "$P/.github/workflows/npm-publish.yml" ]
  [ ! -e "$P/.github/workflows/dependency-audit.yml" ]
}

@test "the npm-ci adapter docs describe the audit job, the scheduled workflow and audit_level" {
  doc="$REPO_ROOT/skills/j-publish/adapters/npm-ci.md"
  grep -q 'audit_level' "$doc"
  grep -q 'dependency-audit.yml' "$doc"
  grep -q 'needs: audit' "$doc"
  grep -q 'audit-workflow.yml.tpl' "$doc"
  grep -q 'npm-ci.md' "$REPO_ROOT/skills/j-publish/adapters/npm.md"
}
