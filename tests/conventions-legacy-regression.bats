#!/usr/bin/env bats
#
# Byte-identical regression suite for a project with NO commit-format.template and NO commit-trace (E79_S03_T01).
#
# Why this exists: epic E79 (story E79_S03) adds opt-in conventions settings. A project that configures neither must
# behave exactly as it does today, and every later E79_S03 task is checked against these goldens. The goldens were
# captured from the real, unmodified scripts; nothing here is a hand-written expectation.
#
# GOLDENS CAPTURED AT: commit 44ec43ea0973c8bc84cd1dc95a7748e1ea7743b7 (base of branch E79_S03_T01-legacy-golden-regression,
# 2026-10-25). Every script, schema, preset and map listed below was unmodified relative to that commit when the goldens
# were captured (`git diff HEAD` empty for them). The goldens themselves are added by the commits that follow it.
#
# GOLDENS ARE NEVER REGENERATED BY A TEST RUN. They change only through a deliberate, reviewed change: run
#   bash tests/helpers/capture-conventions-legacy-golden.sh
# by hand and review the resulting diff. The capture script refuses to run under bats (see the test below).
#
# What is pinned (cases are defined once, in tests/helpers/conventions-legacy-golden.bash, and rendered by the same
# code at capture time and here, so the compared bytes are exactly the captured bytes):
#   scripts/validate-conventions.sh                       instances (valid, empty, commit-format only, invalid, malformed,
#                                                         absent, usage) and --presets on templates/conventions-presets.json
#   scripts/conventions-digest.sh                         --agent developer|tester|scrum-master|commit and no agent, the
#                                                         JENGA_CONVENTIONS_DIGEST_MAX_LINES=4 (and 5) cap, nothing-to-say cases
#   scripts/generate-convention-checklist.sh --print      all 9 categories, empty, commit-format only, invalid, no file
#   skills/j-conventions/scripts/conventions-entry.sh     categories (both formats), presets for every category, path,
#                                                         show, check, and the write path (draft-init/set/skip/diff/commit)
#   skills/j-conventions/scripts/detect-conventions.sh    an empty directory with a registry
#   skills/j-commit/scripts/commit-subject-check.sh       a dependent consumer: reads conventions.json via the validator
# These are all the scripts that read templates/conventions-schema.json (`grep -rl conventions-schema scripts skills`)
# plus that one consumer. The fixtures are all9 (first shipped preset of each category), empty (an empty `categories`
# object: nothing recorded), fmt-only (only commit-format: something recorded), fmt-custom, and invalid / malformed inputs.
#
# Comparison is `cmp` (byte for byte), never a pattern match. Time-varying output (scratch paths, the random draft-file
# suffix) is normalised while the case is RENDERED, which is the same step that produced the goldens; the comparison
# itself normalises nothing.
#
# Expected, deliberate golden changes in later tasks: `conventions-entry.sh categories --format json` embeds each
# category's `values` field list from the schema. If a later E79_S03 task adds `template` to commit-format.values,
# entry-categories-json.golden changes by design and is regenerated in a reviewed diff; nothing else here should move.
#
# Nothing here writes this repository's project/configs/: every case runs in $BATS_TEST_TMPDIR with JENGA_PROJECT_ROOT
# aimed at a scratch project, and setup/teardown prove it with a checksum, as the sibling conventions suites do.
#
# Does not start a nested suite run (it launches no bats process).

bats_require_minimum_version 1.5.0
load helpers/conventions-legacy-golden

REPO_ROOT="$(cd "$(dirname "$BATS_TEST_FILENAME")/.." && pwd)"
REAL_CONFIGS="$REPO_ROOT/project/configs"
CAPTURE="$REPO_ROOT/tests/helpers/capture-conventions-legacy-golden.sh"

setup() {
  REAL_SUM="$(find "$REAL_CONFIGS" -type f -exec cksum {} + | sort | cksum)"
  CLG_WORK="$BATS_TEST_TMPDIR/work"
  OUT="$BATS_TEST_TMPDIR/out"
  mkdir -p "$CLG_WORK" "$OUT"
  GOLDEN="$CLG_GOLDEN_DIR_DEFAULT"
}

teardown() {
  [ "$(find "$REAL_CONFIGS" -type f -exec cksum {} + | sort | cksum)" = "$REAL_SUM" ]
}

# --- the comparison -------------------------------------------------------------------------------------------

# compare_case <case>: render the case against the current scripts and cmp it with its golden (in $GOLDEN).
compare_case() {
  local c="$1"
  if ! clg_render "$c" "$OUT/$c.golden"; then
    printf 'render failed: %s\n' "$c" >&2
    return 1
  fi
  if [ ! -f "$GOLDEN/$c.golden" ]; then
    printf 'missing golden: %s\n' "$c" >&2
    return 1
  fi
  if ! cmp "$GOLDEN/$c.golden" "$OUT/$c.golden" >&2; then
    diff "$GOLDEN/$c.golden" "$OUT/$c.golden" | head -20 >&2
    return 1
  fi
  return 0
}

# compare_group <prefix>: compare every case whose name starts with the prefix; name each one that differs.
compare_group() {
  local prefix="$1" c n=0 bad=""
  for c in $(clg_cases); do
    case "$c" in
      "$prefix"*) ;;
      *) continue ;;
    esac
    n=$((n + 1))
    compare_case "$c" || bad="$bad $c"
  done
  if [ "$n" -eq 0 ]; then
    printf 'no case starts with %s\n' "$prefix" >&2
    return 1
  fi
  if [ -n "$bad" ]; then
    printf 'differs from its golden:%s\n' "$bad" >&2
    return 1
  fi
  return 0
}

# --- byte-for-byte regression, per script ---------------------------------------------------------------------

@test "validator: instance and --presets output, stderr and exit status are byte-identical to the goldens" {
  compare_group validate-
}

@test "digest: every --agent, no agent, the line cap and the nothing-to-say cases are byte-identical" {
  compare_group digest-
}

@test "generator --print: all 9 categories, empty, commit-format only, invalid and no file are byte-identical" {
  compare_group generate-
}

@test "entry: categories (both formats), presets for every category, show, check and the write path are byte-identical" {
  compare_group entry-
}

@test "detector: an empty directory with a registry is byte-identical" {
  compare_group detect-
}

@test "commit-subject-check: board, non-board and no-convention subjects are byte-identical" {
  compare_group subject-
}

# --- the default-off path is exercised for both nothing recorded and something recorded -----------------------

@test "goldens: nothing-recorded (empty categories) and something-recorded (commit-format only) are both pinned" {
  local c
  for c in validate-empty validate-fmt-only digest-empty-none digest-empty-developer digest-fmt-only-none \
           digest-fmt-only-developer digest-fmt-only-commit generate-print-empty generate-print-fmt-only; do
    [ -s "$GOLDEN/$c.golden" ] || { printf 'missing or empty golden: %s\n' "$c" >&2; return 1; }
  done
  # Nothing recorded: the digest says nothing, the generator prints an empty array, both exit 0.
  grep -qx -- '--- exit' "$GOLDEN/digest-empty-developer.golden"
  [ "$(sed -n '/^--- stdout$/,/^--- stderr$/p' "$GOLDEN/digest-empty-developer.golden" | wc -l | tr -d ' ')" = "2" ]
  grep -qxF '[]' "$GOLDEN/generate-print-empty.golden"
  # Something recorded: one category shows up in the digest and the generator output.
  grep -qF 'Project conventions (1 recorded' "$GOLDEN/digest-fmt-only-developer.golden"
  grep -qF '"id": "conv-commit-format"' "$GOLDEN/generate-print-fmt-only.golden"
}

@test "goldens: every case has a golden, no golden is orphaned, and each states a command and an exit status" {
  local c f b missing="" orphan=""
  for c in $(clg_cases); do
    [ -s "$GOLDEN/$c.golden" ] || missing="$missing $c"
    grep -q '^\$ ' "$GOLDEN/$c.golden" || missing="$missing $c(no-command)"
    grep -q '^--- exit$' "$GOLDEN/$c.golden" || missing="$missing $c(no-exit)"
  done
  for f in "$GOLDEN"/*.golden; do
    b="$(basename "$f" .golden)"
    clg_cases | grep -qxF -- "$b" || orphan="$orphan $b"
  done
  [ -z "$missing" ] || { printf 'missing or incomplete:%s\n' "$missing" >&2; return 1; }
  [ -z "$orphan" ] || { printf 'orphaned goldens:%s\n' "$orphan" >&2; return 1; }
}

@test "goldens: cover the validator (instance and --presets), the digest for 4 agents plus none, generator --print, entry categories and presets, and the detector" {
  local c
  for c in validate-all9 validate-presets \
           digest-all9-developer digest-all9-tester digest-all9-scrum-master digest-all9-commit digest-all9-none digest-all9-none-max4 \
           generate-print-all9 generate-print-fmt-only \
           entry-categories-lines entry-categories-json detect-empty-dir; do
    [ -s "$GOLDEN/$c.golden" ] || { printf 'missing golden: %s\n' "$c" >&2; return 1; }
  done
  for c in $CLG_CATEGORIES; do
    [ -s "$GOLDEN/entry-presets-$c.golden" ] || { printf 'missing golden: entry-presets-%s\n' "$c" >&2; return 1; }
  done
  # Spot facts, so an all-empty golden set cannot pass vacuously.
  grep -qxF 'PASS project/configs/conventions.json' "$GOLDEN/validate-all9.golden"
  grep -qF 'Project conventions (9 recorded' "$GOLDEN/digest-all9-none.golden"
  grep -qF '"id": "conv-naming"' "$GOLDEN/generate-print-all9.golden"
  [ "$(grep -c "^testing$(printf '\t')" "$GOLDEN/entry-categories-lines.golden")" = "1" ]
  grep -qF '"detect_version": 1' "$GOLDEN/detect-empty-dir.golden"
}

@test "goldens: carry no scratch path (normalisation held at capture time)" {
  run grep -lE '/var/folders|/private/var|/tmp/|bats-run|clg-capture|BATS_' "$GOLDEN"/*.golden
  [ "$status" -eq 1 ]
  [ -z "$output" ]
}

# --- byte-exactness is real -----------------------------------------------------------------------------------

@test "negative: a deliberate one-byte change to a golden makes the comparison fail" {
  local mut="$BATS_TEST_TMPDIR/mutated"
  cp -R "$GOLDEN" "$mut"
  # The unmodified copy matches, so the failure below is caused by the mutation alone.
  GOLDEN="$mut"
  run compare_case validate-all9
  [ "$status" -eq 0 ]
  # Replace the first byte (the "$" of the command line) in place: same length, one byte different.
  printf 'X' | dd of="$mut/validate-all9.golden" bs=1 count=1 conv=notrunc 2>/dev/null
  run compare_case validate-all9
  [ "$status" -eq 1 ]
  [[ "$output" == *"differ: "* ]]
}

@test "negative: one extra trailing byte (a newline difference) also makes the comparison fail" {
  local mut="$BATS_TEST_TMPDIR/mutated"
  cp -R "$GOLDEN" "$mut"
  GOLDEN="$mut"
  printf '\n' >> "$mut/digest-all9-developer.golden"
  run compare_case digest-all9-developer
  [ "$status" -eq 1 ]
  [[ "$output" == *"EOF on"* || "$output" == *"differ: "* ]]
}

@test "negative: a missing golden is a failure, never a silent pass" {
  local mut="$BATS_TEST_TMPDIR/mutated"
  cp -R "$GOLDEN" "$mut"
  GOLDEN="$mut"
  rm -f "$mut/detect-empty-dir.golden"
  run compare_case detect-empty-dir
  [ "$status" -eq 1 ]
  [[ "$output" == *"missing golden: detect-empty-dir"* ]]
}

# --- the harness itself ---------------------------------------------------------------------------------------

@test "capture script: refuses to run under bats and leaves the goldens untouched" {
  local before after
  before="$(find "$GOLDEN" -type f -exec cksum {} + | sort | cksum)"
  run env BATS_TEST_FILENAME="$BATS_TEST_FILENAME" bash "$CAPTURE"
  [ "$status" -eq 2 ]
  [[ "$output" == *"refusing to run inside a bats test"* ]]
  after="$(find "$GOLDEN" -type f -exec cksum {} + | sort | cksum)"
  [ "$before" = "$after" ]
}

@test "helpers: pass bash -n and use no bash 4 features" {
  run bash -n "$REPO_ROOT/tests/helpers/conventions-legacy-golden.bash"
  [ "$status" -eq 0 ]
  run bash -n "$CAPTURE"
  [ "$status" -eq 0 ]
  run grep -nE 'declare -A|mapfile|readarray|\$\{[A-Za-z_]+(,,|\^\^)\}|\|&|;;&|coproc' \
    "$REPO_ROOT/tests/helpers/conventions-legacy-golden.bash" "$CAPTURE"
  [ "$status" -eq 1 ]
}

@test "write flow: the cases that write conventions.json leave this repository's project/configs/ untouched" {
  compare_case entry-write-flow
  compare_case entry-write-flow-rejections
  [ "$(find "$REAL_CONFIGS" -type f -exec cksum {} + | sort | cksum)" = "$REAL_SUM" ]
}
