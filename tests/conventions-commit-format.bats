#!/usr/bin/env bats
#
# Schema-shape coverage for the commit-format template fields and the opt-in commit-trace category
# (epic E79, story E79_S03, task E79_S03_T04). E79_S03_T05 extends this file with the enforcement cases.
#
# Contract under test: templates/conventions-schema.json. This task declares the settings as data; the validator
# already understood every spec property used (enum, reserved, max_length, pattern, default, opt_in_categories)
# from E79_S03_T03, so most cases here ask the real validator to accept or reject a generated instance.
#
# Default-off guarantee, as pinned here (condition recorded with the task): every VALID default-off input is
# byte-identical and every exit code is unchanged; error text that ENUMERATES the allowed keys or categories lists
# the new schema ids. Six legacy goldens carry exactly that enumeration and were regenerated by this task; the
# other 57 are pinned below by an aggregate checksum and re-rendered live.
#
# Every fixture is generated into $BATS_TEST_TMPDIR. Nothing here writes this repository's project/configs/.
# Starts no nested suite run (it launches no bats process).

bats_require_minimum_version 1.5.0
load helpers/assertions
load helpers/conventions-legacy-golden

REPO_ROOT="$(cd "$(dirname "$BATS_TEST_FILENAME")/.." && pwd)"
VALIDATE="$REPO_ROOT/scripts/validate-conventions.sh"
SCHEMA="$REPO_ROOT/templates/conventions-schema.json"
PRESETS="$REPO_ROOT/templates/conventions-presets.json"
REAL_CONFIGS="$REPO_ROOT/project/configs"
GOLDEN_DIR="$REPO_ROOT/tests/fixtures/conventions-legacy-golden"

# The goldens that enumerate the allowed keys or categories, regenerated by this task (and only these). The variable
# keeps its original name; entry-presets-unknown (an unknown-category message) was added to the list by E79_S03_T07,
# which makes it seven.
SIX_REGENERATED="digest-invalid entry-categories-json entry-check entry-presets-unknown entry-write-flow-rejections generate-print-invalid validate-invalid"

# Aggregate sha256 of the other 57 goldens: `shasum -a 256` of the `shasum -a 256` lines of those files in C-locale
# name order. Any byte change to any one of them changes this value.
PINNED_58="bb6ee317ebf8065033f15e754aca537606d21689bbe7f57a54811048f2a75c14"

setup() {
  REAL_SUM="$(find "$REAL_CONFIGS" -type f -exec cksum {} + | sort | cksum)"
  F="$BATS_TEST_TMPDIR/conventions.json"
  CLG_WORK="$BATS_TEST_TMPDIR/work"
  OUT="$BATS_TEST_TMPDIR/out"
  mkdir -p "$CLG_WORK" "$OUT"
  unset JENGA_CONVENTIONS_SCHEMA
}

teardown() {
  [ "$(find "$REAL_CONFIGS" -type f -exec cksum {} + | sort | cksum)" = "$REAL_SUM" ]
}

# jq_eq <filter> <expected-json>: the schema filter yields exactly that JSON value (compact).
jq_eq() {
  local got
  got="$(jq -c "$1" "$SCHEMA")"
  if [ "$got" != "$2" ]; then
    printf 'filter: %s\nexpected: %s\n     got: %s\n' "$1" "$2" "$got" >&2
    return 1
  fi
}

# write_instance <commit-format-values-json> [<commit-trace-values-json>]
write_instance() {
  local trace=""
  if [ "$#" -ge 2 ]; then
    trace=",\"commit-trace\":{\"source\":\"custom\",\"summary\":\"trace\",\"values\":$2}"
  fi
  printf '{"conventions_version":1,"categories":{"commit-format":{"source":"custom","summary":"fmt","values":%s}%s}}\n' \
    "$1" "$trace" > "$F"
}

validate() { run --separate-stderr bash "$VALIDATE" "$@"; }

# --- commit-format: the five new fields ---------------------------------------------------------------------

@test "schema: commit-format keeps its 3 existing fields exactly and adds the 5 template fields, all optional" {
  jq_eq '.categories["commit-format"].values | keys_unsorted' \
    '["style","message_regex","subject_max_length","template","ref_source","ref_pattern","on_unresolved","apply_to_board_commits"]'
  jq_eq '.categories["commit-format"].values.style' '{"type":"string","required":true,"single_line":true,"non_empty":true}'
  jq_eq '.categories["commit-format"].values.message_regex' '{"type":"string","required":false,"single_line":true,"non_empty":true}'
  jq_eq '.categories["commit-format"].values.subject_max_length' '{"type":"integer","required":false}'
  jq_eq '[.categories["commit-format"].values | to_entries[] | select(.key | IN("template","ref_source","ref_pattern","on_unresolved","apply_to_board_commits")) | .value.required] | unique' '[false]'
}

@test "schema: template is a single-line non-empty string capped at 80" {
  jq_eq '.categories["commit-format"].values.template' \
    '{"type":"string","required":false,"single_line":true,"non_empty":true,"max_length":80}'
}

@test "schema: ref_source is an enum chain|external_refs|perceived_branch, default chain, with prompt reserved for a later phase" {
  jq_eq '.categories["commit-format"].values.ref_source.type' '"string"'
  jq_eq '.categories["commit-format"].values.ref_source.enum' '["chain","external_refs","perceived_branch"]'
  jq_eq '.categories["commit-format"].values.ref_source.default' '"chain"'
  jq_eq '.categories["commit-format"].values.ref_source.reserved' '{"prompt":"reserved for a later phase"}'
}

@test "schema: ref_pattern is a single-line non-empty string capped at 100 with the default pattern" {
  jq_eq '.categories["commit-format"].values.ref_pattern.max_length' '100'
  jq_eq '.categories["commit-format"].values.ref_pattern.default' '"[A-Z][A-Z0-9]+-[0-9]+"'
  jq_eq '.categories["commit-format"].values.ref_pattern | [.single_line, .non_empty]' '[true,true]'
}

@test "schema: on_unresolved allows only fail (default fail) and its note names Phase 1 and E79_S03" {
  jq_eq '.categories["commit-format"].values.on_unresolved.enum' '["fail"]'
  jq_eq '.categories["commit-format"].values.on_unresolved.default' '"fail"'
  run jq -r '.categories["commit-format"].values.on_unresolved.note' "$SCHEMA"
  [ "$status" -eq 0 ]
  assert_output_contains "Phase 1"
  assert_output_contains "E79_S03"
}

@test "schema: apply_to_board_commits is a boolean defaulting to false" {
  jq_eq '.categories["commit-format"].values.apply_to_board_commits' '{"type":"boolean","required":false,"default":false}'
}

@test "schema: commit-format applies_to is unchanged" {
  jq_eq '.categories["commit-format"].applies_to' \
    '"non-board commits only: EST naming (task(E##_S##_T##):, story(...), epic(...)) stays mandatory for board commits"'
}

# --- commit-trace: the opt-in category ------------------------------------------------------------------------

@test "schema: opt_in_categories holds exactly commit-trace with the label 'Commit traceability'" {
  jq_eq '.opt_in_categories | keys' '["commit-trace"]'
  jq_eq '.opt_in_categories["commit-trace"].label' '"Commit traceability"'
  jq_eq '.opt_in_categories["commit-trace"].values | keys_unsorted' '["mode","trailer_key"]'
}

@test "schema: commit-trace.mode is a setting defaulting to trailer, reserving external-key, topology and ledger for a later phase" {
  jq_eq '.opt_in_categories["commit-trace"].values.mode.enum' '["trailer"]'
  jq_eq '.opt_in_categories["commit-trace"].values.mode.default' '"trailer"'
  jq_eq '.opt_in_categories["commit-trace"].values.mode.reserved | keys' '["external-key","ledger","topology"]'
  jq_eq '[.opt_in_categories["commit-trace"].values.mode.reserved[]] | unique' '["reserved for a later phase"]'
  jq_eq '.opt_in_categories["commit-trace"].values.mode.required' 'false'
}

@test "schema: commit-trace.trailer_key allows only Jenga-Task, which is also its default" {
  jq_eq '.opt_in_categories["commit-trace"].values.trailer_key.enum' '["Jenga-Task"]'
  jq_eq '.opt_in_categories["commit-trace"].values.trailer_key.default' '"Jenga-Task"'
  jq_eq '.opt_in_categories["commit-trace"].values.trailer_key.required' 'false'
}

@test "schema: .categories still has exactly the 9 core ids and commit-trace is not among them" {
  jq_eq '.categories | keys | sort' \
    '["branching","code-comments","commit-format","documentation-placement","file-layout","formatting-linting","language-tooling","naming","testing"]'
  jq_eq '.categories | has("commit-trace")' 'false'
  jq_eq '.top_level_keys' '["conventions_version","categories"]'
}

@test "schema: the comment documents opt_in_categories and the optional field properties" {
  run jq -r '._comment' "$SCHEMA"
  [ "$status" -eq 0 ]
  assert_output_contains "opt_in_categories"
  assert_output_contains "reserved"
  assert_output_contains "default"
}

@test "schema: no string outside _comment and note carries a board id (the shipped files stay free of project provenance)" {
  run jq -r '[paths(strings) as $p | {k: ($p | map(tostring) | last), v: getpath($p)} | select(.k != "_comment" and .k != "note") | .v | scan("E[0-9]{2}_S[0-9]{2}(_T[0-9]{2})?")] | unique | length' "$SCHEMA"
  [ "$status" -eq 0 ]
  [ "$output" = "0" ]
}

# --- the validator accepts and rejects per the schema ---------------------------------------------------------

@test "validator: a commit-format entry with every new field and a commit-trace entry both pass" {
  write_instance '{"style":"ref-summary","template":"{ref} {summary}","ref_source":"external_refs","ref_pattern":"[A-Z]+-[0-9]+","on_unresolved":"fail","apply_to_board_commits":true}' \
    '{"mode":"trailer","trailer_key":"Jenga-Task"}'
  validate "$F"
  [ "$status" -eq 0 ]
  assert_output_contains "PASS"
}

@test "validator: a commit-trace entry with no values recorded passes (every field is optional, defaults apply)" {
  write_instance '{"style":"plain"}' '{}'
  validate "$F"
  [ "$status" -eq 0 ]
}

@test "validator: commit-trace mode external-key, topology and ledger are rejected as reserved for a later phase" {
  local m
  for m in external-key topology ledger; do
    write_instance '{"style":"plain"}' "{\"mode\":\"$m\"}"
    validate "$F"
    [ "$status" -eq 1 ]
    case "$stderr" in *"reserved value"*"reserved for a later phase"*) ;; *) printf 'stderr: %s\n' "$stderr" >&2; return 1 ;; esac
  done
}

@test "validator: a mode outside the vocabulary and a trailer_key other than Jenga-Task are rejected as not allowed" {
  write_instance '{"style":"plain"}' '{"mode":"bogus"}'
  validate "$F"
  [ "$status" -eq 1 ]
  case "$stderr" in *"not an allowed value"*) ;; *) return 1 ;; esac
  write_instance '{"style":"plain"}' '{"trailer_key":"Task-Id"}'
  validate "$F"
  [ "$status" -eq 1 ]
  case "$stderr" in *"not an allowed value"*"Jenga-Task"*) ;; *) printf 'stderr: %s\n' "$stderr" >&2; return 1 ;; esac
}

@test "validator: on_unresolved other than fail and the reserved ref_source prompt are rejected" {
  write_instance '{"style":"plain","on_unresolved":"warn"}'
  validate "$F"
  [ "$status" -eq 1 ]
  case "$stderr" in *"not an allowed value"*) ;; *) return 1 ;; esac
  write_instance '{"style":"plain","ref_source":"prompt"}'
  validate "$F"
  [ "$status" -eq 1 ]
  case "$stderr" in *"reserved value"*"reserved for a later phase"*) ;; *) printf 'stderr: %s\n' "$stderr" >&2; return 1 ;; esac
}

@test "validator: a template over 80 characters, a multi-line template, an empty ref_pattern and a non-boolean flag are rejected" {
  local long
  long="$(printf 'a%.0s' $(seq 1 81))"
  write_instance "{\"style\":\"plain\",\"template\":\"$long\"}"
  validate "$F"
  [ "$status" -eq 1 ]
  write_instance '{"style":"plain","template":"{ref}\n{summary}"}'
  validate "$F"
  [ "$status" -eq 1 ]
  write_instance '{"style":"plain","ref_pattern":""}'
  validate "$F"
  [ "$status" -eq 1 ]
  write_instance '{"style":"plain","apply_to_board_commits":"yes"}'
  validate "$F"
  [ "$status" -eq 1 ]
}

@test "validator: commit-trace is a recognised category in an instance but is unknown once the schema drops opt_in_categories" {
  write_instance '{"style":"plain"}' '{}'
  jq 'del(.opt_in_categories)' "$SCHEMA" > "$BATS_TEST_TMPDIR/schema-no-optin.json"
  JENGA_CONVENTIONS_SCHEMA="$BATS_TEST_TMPDIR/schema-no-optin.json" validate "$F"
  [ "$status" -eq 1 ]
  case "$stderr" in *"unknown category"*"commit-trace"*) ;; *) printf 'stderr: %s\n' "$stderr" >&2; return 1 ;; esac
}

@test "validator: the shipped preset catalog still passes and needs no presets for commit-trace" {
  validate --presets "$PRESETS"
  [ "$status" -eq 0 ]
  jq_eq '.categories | has("commit-trace")' 'false'
  [ "$(jq '.categories | has("commit-trace")' "$PRESETS")" = "false" ]
}

# --- the default-off guarantee --------------------------------------------------------------------------------

@test "default-off: the 57 goldens that do not enumerate allowed keys or categories are byte-identical to their pinned checksum" {
  local c list="" got
  for c in $(clg_cases); do
    case " $SIX_REGENERATED " in *" $c "*) continue ;; esac
    list="$list $c.golden"
  done
  [ "$(printf '%s\n' $list | wc -l | tr -d ' ')" = "57" ]
  got="$(cd "$GOLDEN_DIR" && printf '%s\n' $list | LC_ALL=C sort | xargs shasum -a 256 | shasum -a 256 | awk '{print $1}')"
  if [ "$got" != "$PINNED_58" ]; then
    printf 'aggregate of the 57 unchanged goldens is %s, expected %s\n' "$got" "$PINNED_58" >&2
    return 1
  fi
}

@test "default-off: a valid default-off input renders byte-identical validator, digest and checklist output (live render, cmp)" {
  local c bad="" n=0
  for c in $(clg_cases); do
    case " $SIX_REGENERATED " in *" $c "*) continue ;; esac
    case "$c" in validate-* | digest-* | generate-print-*) ;; *) continue ;; esac
    n=$((n + 1))
    if ! clg_render "$c" "$OUT/$c.golden" || ! cmp -s "$GOLDEN_DIR/$c.golden" "$OUT/$c.golden"; then
      bad="$bad $c"
    fi
  done
  [ "$n" -gt 0 ]
  if [ -n "$bad" ]; then
    printf 'differs from its golden:%s\n' "$bad" >&2
    return 1
  fi
}

# exit_statuses <case>: the exit statuses recorded in a golden, space separated, in frame order.
exit_statuses() {
  awk '/^--- exit$/ { getline; printf "%s ", $0 }' "$GOLDEN_DIR/$1.golden" | sed 's/ $//'
}

@test "default-off: the six regenerated goldens are current and keep the exit statuses they had before the schema change" {
  local c
  for c in $SIX_REGENERATED; do
    clg_render "$c" "$OUT/$c.golden"
    if ! cmp -s "$GOLDEN_DIR/$c.golden" "$OUT/$c.golden"; then
      printf 'stale golden: %s\n' "$c" >&2
      return 1
    fi
  done
  [ "$(exit_statuses validate-invalid)" = "1" ]
  [ "$(exit_statuses digest-invalid)" = "1" ]
  [ "$(exit_statuses generate-print-invalid)" = "1" ]
  [ "$(exit_statuses entry-check)" = "0 0 0 0 0 0 0 0 0" ]
  [ "$(exit_statuses entry-write-flow-rejections)" = "0 1 1 1 1 0 0" ]
  [ "$(exit_statuses entry-categories-json)" = "0" ]
}

@test "default-off: error text that enumerates the allowed keys or categories lists the new schema ids, in schema order" {
  local f
  for f in validate-invalid digest-invalid generate-print-invalid; do
    grep -q 'allowed for commit-format: style, message_regex, subject_max_length, template, ref_source, ref_pattern, on_unresolved, apply_to_board_commits)' "$GOLDEN_DIR/$f.golden"
    grep -q 'allowed: commit-format, branching, naming, code-comments, formatting-linting, testing, file-layout, language-tooling, documentation-placement, commit-trace)' "$GOLDEN_DIR/$f.golden"
  done
  grep -q 'allowed for commit-format: style, message_regex, subject_max_length, template, ref_source, ref_pattern, on_unresolved, apply_to_board_commits)' "$GOLDEN_DIR/entry-check.golden"
  grep -q 'allowed for commit-format: style, message_regex, subject_max_length, template, ref_source, ref_pattern, on_unresolved, apply_to_board_commits)' "$GOLDEN_DIR/entry-write-flow-rejections.golden"
}

@test "default-off: entry-categories-json lists the 5 new commit-format fields and still lists exactly the 9 core categories" {
  local body
  body="$(sed -n '/^--- stdout$/,/^--- stderr$/p' "$GOLDEN_DIR/entry-categories-json.golden" | sed '1d;$d')"
  [ "$(printf '%s' "$body" | jq 'length')" = "9" ]
  [ "$(printf '%s' "$body" | jq -c '[.[].id]')" = '["commit-format","branching","naming","code-comments","formatting-linting","testing","file-layout","language-tooling","documentation-placement"]' ]
  [ "$(printf '%s' "$body" | jq -c '.[0].values | keys_unsorted')" = '["style","message_regex","subject_max_length","template","ref_source","ref_pattern","on_unresolved","apply_to_board_commits"]' ]
}

# =====================================================================================================================
# Write-time enforcement (epic E79, story E79_S03, task E79_S03_T05): the cross-field rules of
# scripts/validate-conventions.sh for the template fields and the commit-trace values. Cases are appended; no
# assertion above this line is edited. The messages name no board id (they ship to consumers), so they say
# "a later phase" and "Phase 1".
# =====================================================================================================================

TPATH="categories.commit-format.values.template"
CF="categories.commit-format.values"

# err_has <fragment>: the last validator run's stderr contains the fragment, else print stderr.
err_has() {
  case "$stderr" in
    *"$1"*) return 0 ;;
  esac
  printf 'expected [%s] in stderr:\n%s\n' "$1" "$stderr" >&2
  return 1
}

# write_template <template-string> [extra-values-json-object]: an instance whose commit-format records that template
# (the string goes through jq, so any character is a faithful JSON string).
write_template() {
  local values
  values="$(jq -n -c --arg t "$1" '{style:"plain", template:$t}')"
  if [ "$#" -ge 2 ]; then
    values="$(jq -c --argjson x "$2" '. + $x' <<<"$values")"
  fi
  write_instance "$values"
}

# in_empty_dir: run from a fresh empty directory, so a stray file created by a hostile value is visible afterwards.
in_empty_dir() {
  HOSTILE_DIR="$BATS_TEST_TMPDIR/hostile"
  rm -rf "$HOSTILE_DIR"
  mkdir -p "$HOSTILE_DIR"
  cd "$HOSTILE_DIR" || return 1
}

# --- rule 1: template validity through the one function ----------------------------------------------------------

@test "enforce 1: template '{ref} {summary}' with apply_to_board_commits true and no commit-trace validates" {
  write_instance '{"style":"ref-summary","template":"{ref} {summary}","apply_to_board_commits":true}'
  validate "$F"
  [ "$status" -eq 0 ]
  assert_output_contains "PASS"
  [ -z "$stderr" ]
}

@test "enforce 1: each invalid template from the grammar list is rejected with the script's message and the JSON path" {
  local t frag
  while IFS='|' read -r t frag; do
    write_template "$(printf '%b' "$t")"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted: %s\n' "$t" >&2; return 1; }
    err_has "invalid template: $TPATH - "
    err_has "$frag"
    case "$output" in FAIL*) ;; *) printf 'stdout: %s\n' "$output" >&2; return 1 ;; esac
  done <<'LIST'
{ref}|{summary} is missing
just words|{summary} is missing
{summary} {summary}|{summary} appears twice (position 11)
{ref} {ref} {summary}|{ref} appears twice (position 7)
{ref}\n{summary}|character 0x0a (a control or non-ASCII character) at position 6
{ref}\t{summary}|character 0x09
{foo} {summary}|unknown placeholder '{foo}' at position 1
{} {summary}|unknown placeholder '{}' at position 1
{ref {summary}|unbalanced '{' at position 1
{summary}}|unbalanced '}' at position 10
{{ref}} {summary}|unbalanced '{' at position 1
{summary|unbalanced '{' at position 1
LIST
}

@test "enforce 1: the empty template, an 81-character template and every shell or regex metacharacter literal are rejected with the script's message" {
  local c long
  write_template ""
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "invalid template: $TPATH - the template is empty"
  long="$(printf 'a%.0s' $(seq 1 72)){summary}"
  write_template "$long"
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "the template is 81 characters; the maximum is 80"
  write_template "$(printf 'a%.0s' $(seq 1 71)){summary}"
  validate "$F"
  [ "$status" -eq 0 ]
  for c in '$' '`' ';' '|' '&' '<' '>' '\' '*' '?' "'" '"' '^' '+' '!' '%' '=' '~'; do
    write_template "{ref} ${c} {summary}"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted metacharacter: %s\n' "$c" >&2; return 1; }
    err_has "character '${c}' at position 7"
  done
}

@test "enforce 1: every allowlisted literal character is accepted, and a template starting with '-' is data" {
  write_template 'Az09 -_:.,/#()[]@{ref}{summary}'
  validate "$F"
  [ "$status" -eq 0 ]
  write_template '--help {summary}'
  validate "$F"
  [ "$status" -eq 0 ]
}

@test "enforce 1: hostile templates recorded as values are rejected and execute nothing (no file is created)" {
  local t
  in_empty_dir
  for t in '{ref} $(touch PWNED) {summary}' '{ref} `touch PWNED` {summary}' '{ref} ; touch PWNED ; {summary}' \
           '{ref} | touch PWNED | {summary}' '{ref} && touch PWNED && {summary}' "{ref} '; touch PWNED; ' {summary}" \
           $'{ref}\ntouch PWNED\n{summary}' $'{ref} {summary}\ntouch PWNED' '{ref} ${IFS}touch${IFS}PWNED {summary}'; do
    write_template "$t"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted hostile template: %s\n' "$t" >&2; return 1; }
    err_has "invalid template: $TPATH - "
  done
  [ -z "$(ls -A "$HOSTILE_DIR")" ]
  [ ! -e "$HOSTILE_DIR/PWNED" ]
  [ ! -e "$BATS_TEST_TMPDIR/PWNED" ]
  [ ! -e "$REPO_ROOT/PWNED" ]
}

@test "enforce 1: a NUL character in a template is reported without launching anything" {
  printf '%s\n' '{"conventions_version":1,"categories":{"commit-format":{"source":"custom","summary":"f","values":{"style":"plain","template":"{summary}\u0000"}}}}' > "$F"
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "invalid template: $TPATH - the template contains a NUL character"
}

@test "enforce 1: every problem in a file is reported, not just the first" {
  write_instance '{"style":"plain","template":"{ref} ; {summary}","on_unresolved":"park","subject_max_length":5}' '{"mode":"ledger"}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "invalid template: $TPATH - "
  err_has "$CF.on_unresolved"
  err_has "$CF.subject_max_length"
  err_has "categories.commit-trace.values.mode"
}

# --- rule 2: dependent fields need a template ---------------------------------------------------------------------

@test "enforce 2: ref_source, ref_pattern, on_unresolved and apply_to_board_commits without a template are rejected as requiring one" {
  local f
  for f in 'ref_source|"chain"' 'ref_pattern|"A+"' 'on_unresolved|"fail"' 'apply_to_board_commits|true'; do
    write_instance "{\"style\":\"plain\",\"${f%%|*}\":${f#*|}}"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted without template: %s\n' "$f" >&2; return 1; }
    err_has "requires template: $CF.${f%%|*} is recorded but $TPATH is not"
  done
  # a disabled opt-in flag is still dependent on a template
  write_instance '{"style":"plain","apply_to_board_commits":false}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "requires template: $CF.apply_to_board_commits"
  # all four together report all four
  write_instance '{"style":"plain","ref_source":"chain","ref_pattern":"A+","on_unresolved":"fail","apply_to_board_commits":true}'
  validate "$F"
  [ "$status" -eq 1 ]
  [ "$(printf '%s\n' "$stderr" | grep -c 'requires template')" = "4" ]
  # with a template each is accepted
  write_instance '{"style":"plain","template":"{ref} {summary}","ref_source":"chain","ref_pattern":"A+","on_unresolved":"fail","apply_to_board_commits":true}'
  validate "$F"
  [ "$status" -eq 0 ]
}

# --- rule 3: ref_pattern ---------------------------------------------------------------------------------------------

@test "enforce 3: a ref_pattern that does not compile as an ERE is rejected" {
  local p
  for p in '(a' '[A-Z' '(a|b'; do
    write_template "{ref} {summary}" "$(jq -n -c --arg p "$p" '{ref_pattern:$p}')"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted pattern: %s\n' "$p" >&2; return 1; }
    err_has "invalid ref_pattern: $CF.ref_pattern does not compile as a POSIX extended regular expression"
  done
}

@test "enforce 3: a ref_pattern of 101 characters is rejected and exactly 100 is accepted" {
  local p100 p101
  p100="$(printf 'A%.0s' $(seq 1 100))"
  p101="${p100}A"
  write_template "{ref} {summary}" "$(jq -n -c --arg p "$p100" '{ref_pattern:$p}')"
  validate "$F"
  [ "$status" -eq 0 ]
  write_template "{ref} {summary}" "$(jq -n -c --arg p "$p101" '{ref_pattern:$p}')"
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "too long: $CF.ref_pattern is 101 characters (maximum 100)"
}

@test "enforce 3: a ref_pattern with a back-reference is rejected" {
  local p
  for p in '(a)\1' '([A-Z]+)-\2' 'x\9'; do
    write_template "{ref} {summary}" "$(jq -n -c --arg p "$p" '{ref_pattern:$p}')"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted pattern: %s\n' "$p" >&2; return 1; }
    err_has "invalid ref_pattern: $CF.ref_pattern contains a back-reference"
  done
}

@test "enforce 3: a ref_pattern that the commit path would refuse (it can match the empty string) is refused at write time" {
  write_template "{ref} {summary}" '{"ref_pattern":"a*"}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "invalid ref_pattern: $CF.ref_pattern - the pattern must not match the empty string"
}

@test "enforce 3: a multi-line ref_pattern is rejected by the single-line rule and never reaches grep" {
  write_template "{ref} {summary}" '{"ref_pattern":"A+\nB+"}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "multi-line value: $CF.ref_pattern"
}

@test "enforce 3: hostile and option-like ref_pattern values are inert data" {
  local p
  in_empty_dir
  for p in '$(touch PWNED)' '`touch PWNED`' '-x[0-9]+' '--help[0-9]' '[A-Z]+-[0-9]+; touch PWNED'; do
    write_template "{ref} {summary}" "$(jq -n -c --arg p "$p" '{ref_pattern:$p}')"
    validate "$F"
    [ "$status" -eq 0 ] || { printf 'rejected %s: %s\n' "$p" "$stderr" >&2; return 1; }
  done
  [ -z "$(ls -A "$HOSTILE_DIR")" ]
  [ ! -e "$BATS_TEST_TMPDIR/PWNED" ]
}

# --- rule 4: on_unresolved ----------------------------------------------------------------------------------------------

@test "enforce 4: on_unresolved other than fail is rejected with a message that names Phase 1; fail passes" {
  local v
  for v in park warn skip retry FAIL; do
    write_template "{ref} {summary}" "{\"on_unresolved\":\"$v\"}"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted: %s\n' "$v" >&2; return 1; }
    err_has "not an allowed value: $CF.on_unresolved is \"$v\" (allowed: fail)"
    err_has 'Phase 1 accepts only "fail"'
  done
  write_template "{ref} {summary}" '{"on_unresolved":"fail"}'
  validate "$F"
  [ "$status" -eq 0 ]
}

@test "enforce 4: the Phase 1 wording is added to exactly the on_unresolved message" {
  write_template "{ref} {summary}" '{"on_unresolved":"park","ref_source":"bogus"}'
  validate "$F"
  [ "$status" -eq 1 ]
  [ "$(printf '%s\n' "$stderr" | grep -c 'Phase 1')" = "1" ]
  err_has "not an allowed value: $CF.ref_source is \"bogus\" (allowed: chain, external_refs, perceived_branch)"
}

# --- rule 5: ref_source -----------------------------------------------------------------------------------------------------

@test "enforce 5: ref_source prompt is rejected as reserved for a later phase; chain, external_refs and perceived_branch pass" {
  local v
  write_template "{ref} {summary}" '{"ref_source":"prompt"}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "reserved value: $CF.ref_source is \"prompt\" - reserved for a later phase"
  for v in chain external_refs perceived_branch; do
    write_template "{ref} {summary}" "{\"ref_source\":\"$v\"}"
    validate "$F"
    [ "$status" -eq 0 ] || { printf 'rejected: %s\n' "$v" >&2; return 1; }
  done
}

# --- rule 6: subject_max_length ---------------------------------------------------------------------------------------

@test "enforce 6: with a template subject_max_length must be from 20 to 200" {
  local n
  for n in 0 1 19 201 1000 -5; do
    write_template "{ref} {summary}" "{\"subject_max_length\":$n}"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted: %s\n' "$n" >&2; return 1; }
    err_has "out of range: $CF.subject_max_length is $n (with a template it must be from 20 to 200)"
  done
  for n in 20 72 200; do
    write_template "{ref} {summary}" "{\"subject_max_length\":$n}"
    validate "$F"
    [ "$status" -eq 0 ] || { printf 'rejected: %s\n' "$n" >&2; return 1; }
  done
}

@test "enforce 6: without a template the subject_max_length rule is unchanged (no range)" {
  local n
  for n in 1 5 19 201 100000; do
    write_instance "{\"style\":\"plain\",\"subject_max_length\":$n}"
    validate "$F"
    [ "$status" -eq 0 ] || { printf 'rejected: %s\n' "$n" >&2; return 1; }
    [ -z "$stderr" ]
  done
  write_instance '{"style":"plain","subject_max_length":"72"}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "wrong type: $CF.subject_max_length must be an integer"
}

@test "enforce 6: a non-integer subject_max_length with a template gets the type message only, not a range message" {
  write_template "{ref} {summary}" '{"subject_max_length":"72"}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "wrong type: $CF.subject_max_length must be an integer"
  case "$stderr" in *"out of range"*) return 1 ;; esac
  write_template "{ref} {summary}" '{"subject_max_length":true}'
  validate "$F"
  [ "$status" -eq 1 ]
  case "$stderr" in *"out of range"*) return 1 ;; esac
}

# --- rule 7: message_regex is never reinterpreted ---------------------------------------------------------------------

@test "enforce 7: a legacy commit-format with message_regex and no template validates and is reported as before" {
  write_instance '{"style":"conventional","message_regex":"^(feat|fix): .+","subject_max_length":72}'
  validate "$F"
  [ "$status" -eq 0 ]
  [ "$output" = "PASS $F" ]
  [ -z "$stderr" ]
}

@test "enforce 7: an entry with both message_regex and template validates and the file is not rewritten" {
  local before after
  write_instance '{"style":"conventional","message_regex":"^(feat|fix): .+","template":"{ref} {summary}","apply_to_board_commits":true}'
  before="$(cksum < "$F")"
  validate "$F"
  [ "$status" -eq 0 ]
  after="$(cksum < "$F")"
  [ "$before" = "$after" ]
  [ "$(jq -r '.categories["commit-format"].values.message_regex' "$F")" = '^(feat|fix): .+' ]
  [ "$(jq -r '.categories["commit-format"].values.template' "$F")" = '{ref} {summary}' ]
}

@test "enforce 7: a message_regex is still checked by the per-field rules when a template is also recorded" {
  write_instance '{"style":"plain","message_regex":"a\nb","template":"{ref} {summary}"}'
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "multi-line value: $CF.message_regex"
}

# --- rule 8: commit-trace ------------------------------------------------------------------------------------------------

@test "enforce 8: commit-trace mode external-key, topology and ledger are rejected as reserved for a later phase" {
  local m
  for m in external-key topology ledger; do
    write_instance '{"style":"plain"}' "{\"mode\":\"$m\"}"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted: %s\n' "$m" >&2; return 1; }
    err_has "reserved value: categories.commit-trace.values.mode is \"$m\" - reserved for a later phase"
  done
}

@test "enforce 8: commit-trace mode trailer, an absent mode and an empty values object pass" {
  write_instance '{"style":"plain"}' '{"mode":"trailer"}'
  validate "$F"
  [ "$status" -eq 0 ]
  write_instance '{"style":"plain"}' '{"trailer_key":"Jenga-Task"}'
  validate "$F"
  [ "$status" -eq 0 ]
  write_instance '{"style":"plain"}' '{}'
  validate "$F"
  [ "$status" -eq 0 ]
}

@test "enforce 8: a trailer_key other than Jenga-Task is rejected" {
  local k
  for k in Task-Id jenga-task "Jenga-Task " Co-authored-by; do
    write_instance '{"style":"plain"}' "$(jq -n -c --arg k "$k" '{trailer_key:$k}')"
    validate "$F"
    [ "$status" -eq 1 ] || { printf 'accepted: [%s]\n' "$k" >&2; return 1; }
    err_has "not an allowed value: categories.commit-trace.values.trailer_key"
    err_has "(allowed: Jenga-Task)"
  done
  write_instance '{"style":"plain"}' '{"mode":"trailer","trailer_key":"Jenga-Task"}'
  validate "$F"
  [ "$status" -eq 0 ]
}

@test "enforce 8: the standard entry rules apply to commit-trace (source, summary, values, block strength)" {
  printf '%s\n' '{"conventions_version":1,"categories":{"commit-trace":{"values":{}}}}' > "$F"
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "missing required field: categories.commit-trace.source"
  err_has "missing required field: categories.commit-trace.summary"
  printf '%s\n' '{"conventions_version":1,"categories":{"commit-trace":{"source":"custom","summary":"t"}}}' > "$F"
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "missing required field: categories.commit-trace.values"
  printf '%s\n' '{"conventions_version":1,"categories":{"commit-trace":{"source":"custom","summary":"t","values":{"bogus":1}}}}' > "$F"
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "unknown key in values: categories.commit-trace.values.bogus (allowed for commit-trace: mode, trailer_key)"
  printf '%s\n' '{"conventions_version":1,"categories":{"commit-trace":{"source":"custom","summary":"t","values":{},"strength":"block"}}}' > "$F"
  validate "$F"
  [ "$status" -eq 1 ]
  err_has 'block strength: categories.commit-trace.strength is "block"'
  printf '%s\n' '{"conventions_version":1,"categories":{"commit-trace":{"source":"custom","summary":"t","values":{"mode":"trailer"},"strength":"confirm"}}}' > "$F"
  validate "$F"
  [ "$status" -eq 0 ]
}

@test "enforce 8: a commit-trace entry without any opt-in flag is accepted (it is inert)" {
  printf '%s\n' '{"conventions_version":1,"categories":{"commit-trace":{"source":"custom","summary":"t","values":{"mode":"trailer","trailer_key":"Jenga-Task"}}}}' > "$F"
  validate "$F"
  [ "$status" -eq 0 ]
  write_instance '{"style":"plain","template":"{ref} {summary}"}' '{"mode":"trailer"}'
  validate "$F"
  [ "$status" -eq 0 ]
}

# --- the same rules guard preset catalogs -----------------------------------------------------------------------------

@test "enforce presets: a commit-format preset is held to the same cross-field rules" {
  jq '.categories["commit-format"][0].values.ref_source = "chain"' "$PRESETS" > "$BATS_TEST_TMPDIR/p1.json"
  validate --presets "$BATS_TEST_TMPDIR/p1.json"
  [ "$status" -eq 1 ]
  err_has "requires template: categories.commit-format[0].values.ref_source"
  jq '.categories["commit-format"][0].values.template = "{ref} $(touch PWNED) {summary}"' "$PRESETS" > "$BATS_TEST_TMPDIR/p2.json"
  validate --presets "$BATS_TEST_TMPDIR/p2.json"
  [ "$status" -eq 1 ]
  err_has "invalid template: categories.commit-format[0].values.template - "
  jq '.categories["commit-format"][0].values += {template:"{ref} {summary}", ref_source:"chain"}' "$PRESETS" > "$BATS_TEST_TMPDIR/p3.json"
  validate --presets "$BATS_TEST_TMPDIR/p3.json"
  [ "$status" -eq 0 ]
}

# --- argv-only invocation: the template is never part of a shell string ---------------------------------------------

# validator_python: the python program embedded in the validator (from the python3 line to the PY marker).
validator_python() {
  sed -n '/^  python3 - /,/^PY$/p' "$VALIDATE"
}

@test "enforce argv: the validator's python block has no shell=True, eval, exec, os.system or os.popen" {
  local py hits pat
  pat='shell[[:space:]]*=[[:space:]]*True|(^|[^A-Za-z_.])(eval|exec)\(|os\.(system|popen)|commands\.|subprocess\.(getoutput|getstatusoutput|call|check_output|Popen)'
  py="$(validator_python)"
  [ "$(printf '%s\n' "$py" | wc -l | tr -d ' ')" -gt 200 ]
  hits="$(printf '%s\n' "$py" | grep -nE "$pat" || true)"
  [ -z "$hits" ] || { printf 'unsafe construct:\n%s\n' "$hits" >&2; return 1; }
  # canary: the pattern does detect the forms it is meant to forbid
  printf '%s\n' 'subprocess.run(cmd, shell=True)' 'os.system(x)' 'eval(t)' > "$BATS_TEST_TMPDIR/canary.py"
  [ "$(grep -cE "$pat" "$BATS_TEST_TMPDIR/canary.py")" = "3" ]
}

@test "enforce argv: the only subprocess call is subprocess.run with an argument list" {
  local py
  py="$(validator_python)"
  [ "$(printf '%s\n' "$py" | grep -c 'subprocess\.run(')" = "1" ]
  printf '%s\n' "$py" | grep -q 'proc = subprocess.run(argv, shell=False, stdin=subprocess.DEVNULL'
  printf '%s\n' "$py" | grep -qF 'return run_argv(["bash", TEMPLATE_SCRIPT] + list(args))'
  printf '%s\n' "$py" | grep -qF 'template_script("validate", template)'
  printf '%s\n' "$py" | grep -qF 'run_argv(["grep", "-E", "-e", pattern, os.devnull])'
}

@test "enforce argv: the template reaches commit-template.sh as one argument" {
  local dir="$BATS_TEST_TMPDIR/stubbed"
  mkdir -p "$dir/scripts" "$dir/templates"
  cp "$VALIDATE" "$dir/scripts/validate-conventions.sh"
  cp "$SCHEMA" "$dir/templates/conventions-schema.json"
  cat > "$dir/scripts/commit-template.sh" <<'STUB'
#!/usr/bin/env bash
{
  printf 'argc=%s\n' "$#"
  i=0
  for a in "$@"; do i=$((i + 1)); printf 'arg%s=[%s]\n' "$i" "$a"; done
} >> "$STUB_LOG"
exit 0
STUB
  write_instance '{"style":"plain","template":"a b; $(x) `y` \"q\" {summary}"}'
  STUB_LOG="$dir/log" run --separate-stderr bash "$dir/scripts/validate-conventions.sh" "$F"
  [ "$status" -eq 0 ]
  [ "$(sed -n 1p "$dir/log")" = "argc=2" ]
  [ "$(sed -n 2p "$dir/log")" = "arg1=[validate]" ]
  [ "$(sed -n 3p "$dir/log")" = 'arg2=[a b; $(x) `y` "q" {summary}]' ]
  [ "$(wc -l < "$dir/log" | tr -d ' ')" = "3" ]
}

@test "enforce argv: a stub that rejects the template makes the validator report the stub's message (it parses nothing itself)" {
  local dir="$BATS_TEST_TMPDIR/stubbed2"
  mkdir -p "$dir/scripts" "$dir/templates"
  cp "$VALIDATE" "$dir/scripts/validate-conventions.sh"
  cp "$SCHEMA" "$dir/templates/conventions-schema.json"
  printf '%s\n' '#!/usr/bin/env bash' "echo 'commit-template: invalid template: stub says no' >&2" 'exit 3' > "$dir/scripts/commit-template.sh"
  write_instance '{"style":"plain","template":"{summary}"}'
  run --separate-stderr bash "$dir/scripts/validate-conventions.sh" "$F"
  [ "$status" -eq 1 ]
  err_has "invalid template: $TPATH - stub says no"
}

@test "enforce argv: with no commit-template.sh the validator fails closed, and only when a template is recorded" {
  local dir="$BATS_TEST_TMPDIR/stubbed3"
  mkdir -p "$dir/scripts" "$dir/templates"
  cp "$VALIDATE" "$dir/scripts/validate-conventions.sh"
  cp "$SCHEMA" "$dir/templates/conventions-schema.json"
  write_instance '{"style":"plain"}'
  run --separate-stderr bash "$dir/scripts/validate-conventions.sh" "$F"
  [ "$status" -eq 0 ]
  write_instance '{"style":"plain","template":"{summary}"}'
  run --separate-stderr bash "$dir/scripts/validate-conventions.sh" "$F"
  [ "$status" -eq 1 ]
  err_has "$TPATH"
}

# --- portability ------------------------------------------------------------------------------------------------------------

@test "enforce portability: the validator passes bash -n and its shell part uses no bash 4 feature" {
  local sh_part hits
  run bash -n "$VALIDATE"
  [ "$status" -eq 0 ]
  sh_part="$(sed '/^CONVENTIONS_SCHEMA=/,$d' "$VALIDATE" | grep -vE '^[[:space:]]*#')"
  hits="$(printf '%s\n' "$sh_part" | grep -nE 'declare -A|mapfile|readarray|\$\{[A-Za-z_]+(,,|\^\^)|&>>|\|&|coproc|\[\[ -v ' || true)"
  [ -z "$hits" ] || { printf 'bash 4 feature:\n%s\n' "$hits" >&2; return 1; }
}

@test "enforce portability: under /bin/bash the template cases give the same answers" {
  [ -x /bin/bash ] || skip "/bin/bash is not present"
  write_instance '{"style":"plain","template":"{ref} {summary}","apply_to_board_commits":true}'
  run --separate-stderr /bin/bash "$VALIDATE" "$F"
  [ "$status" -eq 0 ]
  write_instance '{"style":"plain","template":"{ref} $(touch PWNED) {summary}"}'
  run --separate-stderr /bin/bash "$VALIDATE" "$F"
  [ "$status" -eq 1 ]
  err_has "invalid template: $TPATH - "
}

@test "enforce default-off: an instance with none of the new keys produces exactly one PASS line and nothing on stderr" {
  write_instance '{"style":"conventional","message_regex":"^x","subject_max_length":5}'
  validate "$F"
  [ "$status" -eq 0 ]
  [ "$output" = "PASS $F" ]
  [ -z "$stderr" ]
}

@test "enforce schema-driven: the cross-field rules apply to the category whose field list declares a template, chosen by the schema and not by id" {
  # a schema that drops the template field from commit-format: the rules no longer run (unknown key reported instead)
  jq 'del(.categories["commit-format"].values.template)' "$SCHEMA" > "$BATS_TEST_TMPDIR/schema-no-template.json"
  write_instance '{"style":"plain","template":"{ref} ; {summary}"}'
  JENGA_CONVENTIONS_SCHEMA="$BATS_TEST_TMPDIR/schema-no-template.json" validate "$F"
  [ "$status" -eq 1 ]
  err_has "unknown key in values: $CF.template"
  case "$stderr" in *"invalid template"*) return 1 ;; esac
  # the shipped schema runs them
  validate "$F"
  [ "$status" -eq 1 ]
  err_has "invalid template: $TPATH - "
}
