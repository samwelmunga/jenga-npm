{
  "defaultMode": "acceptEdits",
  "permissions": {
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(git stash *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  }
}
